#!/bin/bash

mode="update"
if [ $# -gt 0 ]; then
  if [ "$1" = "--setup" ] || [ "$1" = "-s" ]; then
    mode="setup"
  else
    printf "\033[1;32m%s\033[m\n" "Error: Invalid option $1. You can only use --setup or -s."
    exit 1
  fi
fi

start_time=`date +%s`
printf "\033[1;33m%s\033[m\n" "Running $mode..."

if [ "$mode" = "setup" ]; then
  apt-get update -y
  apt-get install -y curl unzip zip
  export BUN_INSTALL="/usr/local"
  curl -fsSL https://bun.sh/install | bash
  unset BUN_INSTALL
  bun install -g @playwright/test
  bun x playwright install-deps
  chown -R albatross:albatross /home/albatross/dev
fi

if [ "$mode" = "update" ]; then
  if ! command -v bun &> /dev/null; then
    printf "\033[1;31m%s\033[m\n" "Error: bun is not installed. Please run 'albatross --setup' first."
    exit 1
  fi
  apt-get update -y
  apt-get upgrade -y
  apt-get full-upgrade -y
  apt-get autoremove -y
  apt-get autoclean -y
  export BUN_INSTALL="/usr/local"
  curl -fsSL https://bun.sh/install | bash
  unset BUN_INSTALL
  bun install -g @playwright/test
  bun x playwright install-deps
  chown -R albatross:albatross /home/albatross/dev
fi

end_time=`date +%s`
time=$((end_time - start_time))
printf "\033[1;32m%s\033[m\n" "albatross $mode completed in $time seconds."
